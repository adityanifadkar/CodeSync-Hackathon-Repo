import cv2
from ultralytics import YOLO
from collections import deque, Counter

# =========================================================
# NEW IMPROVED MODEL
# =========================================================

MODEL_PATH = r"C:\Users\Gargi\OneDrive\Desktop\REE_PROJECT\training\ewaste_clean_18class_better\weights\best.pt"

print("Loading improved model...")

model = YOLO(MODEL_PATH)

print("✅ Model loaded!")
print("\nClasses:")
print(model.names)


# =========================================================
# REE DATABASE
# Prototype / estimated values
# =========================================================

REE_DATABASE = {

    "Battery": {
        "Neodymium": 0.0
    },

    "Keyboard": {},

    "Microwave": {
        "Neodymium": 1.0,
        "Praseodymium": 0.5
    },

    "Mobile": {
        "Neodymium": 0.5,
        "Praseodymium": 0.2,
        "Dysprosium": 0.05
    },

    "Mouse": {
        "Neodymium": 0.2
    },

    "PCB": {
        "Neodymium": 0.1
    },

    "Player": {
        "Neodymium": 0.2
    },

    "Printer": {
        "Neodymium": 0.1
    },

    "Television": {
        "Europium": 0.1,
        "Terbium": 0.05
    },

    "Washing Machine": {
        "Neodymium": 0.5,
        "Dysprosium": 0.1
    },

    "CPU": {
        "Neodymium": 0.05,
        "Dysprosium": 0.01
    },

    "CPU_Cooler": {
        "Neodymium": 0.10
    },

    "Disk_Drive": {
        "Neodymium": 1.50,
        "Praseodymium": 0.30,
        "Dysprosium": 0.10
    },

    "GPU": {
        "Neodymium": 0.10,
        "Dysprosium": 0.02
    },

    "Motherboard": {
        "Neodymium": 0.05,
        "Praseodymium": 0.02
    },

    "Optical_Drive": {
        "Neodymium": 0.05
    },

    "PSU": {
        "Neodymium": 0.05
    },

    "RAM_Stick": {
        "Neodymium": 0.01
    }
}


# =========================================================
# SETTINGS
# =========================================================

BOX_SIZE = 320

INFERENCE_EVERY = 3

HISTORY_SIZE = 8

MIN_CONFIDENCE = 0.40


# =========================================================
# CAMERA
# =========================================================

cap = cv2.VideoCapture(0)

cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

if not cap.isOpened():
    print("❌ Webcam not found!")
    raise SystemExit

print("\n📷 CAMERA READY")
print("Place ONE component inside the GREEN BOX.")
print("Press Q to quit.")


# =========================================================
# SMOOTHING
# =========================================================

prediction_history = deque(maxlen=HISTORY_SIZE)

current_name = "Waiting..."
current_confidence = 0.0

frame_count = 0


# =========================================================
# MAIN LOOP
# =========================================================

while True:

    ret, frame = cap.read()

    if not ret:
        print("❌ Camera frame error.")
        break

    frame_count += 1

    height, width = frame.shape[:2]

    # -----------------------------------------------------
    # GREEN BOX
    # -----------------------------------------------------

    x1 = (width - BOX_SIZE) // 2
    y1 = (height - BOX_SIZE) // 2

    x2 = x1 + BOX_SIZE
    y2 = y1 + BOX_SIZE

    cv2.rectangle(
        frame,
        (x1, y1),
        (x2, y2),
        (0, 255, 0),
        3
    )


    # -----------------------------------------------------
    # CROP BOX
    # -----------------------------------------------------

    roi = frame[y1:y2, x1:x2]


    # -----------------------------------------------------
    # PREDICT
    # -----------------------------------------------------

    if frame_count % INFERENCE_EVERY == 0:

        results = model.predict(
            source=roi,
            imgsz=224,
            verbose=False
        )

        result = results[0]

        if result.probs is not None:

            class_id = int(result.probs.top1)

            confidence = float(result.probs.top1conf)

            name = model.names[class_id]

            # Only accept confident predictions
            if confidence >= MIN_CONFIDENCE:

                prediction_history.append(
                    (name, confidence)
                )

                names = [
                    item[0]
                    for item in prediction_history
                ]

                if names:

                    most_common = Counter(
                        names
                    ).most_common(1)[0][0]

                    confidence_values = [
                        item[1]
                        for item in prediction_history
                        if item[0] == most_common
                    ]

                    current_name = most_common

                    current_confidence = (
                        sum(confidence_values)
                        / len(confidence_values)
                    )


    # =====================================================
    # DISPLAY
    # =====================================================

    if current_name == "Waiting...":

        cv2.putText(
            frame,
            "PLACE COMPONENT INSIDE GREEN BOX",
            (20, 35),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.65,
            (255, 255, 255),
            2
        )

    else:

        # -------------------------------------------------
        # COMPONENT
        # -------------------------------------------------

        cv2.putText(
            frame,
            "COMPONENT:",
            (20, 35),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.60,
            (0, 255, 0),
            2
        )

        cv2.putText(
            frame,
            current_name,
            (20, 70),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.85,
            (255, 255, 255),
            2
        )


        # -------------------------------------------------
        # CONFIDENCE
        # -------------------------------------------------

        cv2.putText(
            frame,
            f"Confidence: {current_confidence * 100:.1f}%",
            (20, 105),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.60,
            (0, 255, 255),
            2
        )


        # -------------------------------------------------
        # REE
        # -------------------------------------------------

        cv2.putText(
            frame,
            "ESTIMATED REE CONTENT:",
            (20, 145),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.60,
            (255, 255, 255),
            2
        )

        ree_data = REE_DATABASE.get(
            current_name,
            {}
        )

        y = 175

        if ree_data:

            for element, percentage in ree_data.items():

                cv2.putText(
                    frame,
                    f"{element}: {percentage:.2f}%",
                    (25, y),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.55,
                    (255, 255, 255),
                    2
                )

                y += 27

        else:

            cv2.putText(
                frame,
                "No REE data available",
                (25, y),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.55,
                (255, 255, 255),
                2
            )


    # -----------------------------------------------------
    # INSTRUCTIONS
    # -----------------------------------------------------

    cv2.putText(
        frame,
        "Q = Quit",
        (20, height - 20),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.55,
        (255, 255, 255),
        2
    )


    # -----------------------------------------------------
    # SHOW
    # -----------------------------------------------------

    cv2.imshow(
        "AI E-Waste + REE Detector",
        frame
    )


    # -----------------------------------------------------
    # QUIT
    # -----------------------------------------------------

    if cv2.waitKey(1) & 0xFF == ord("q"):
        break


# =========================================================
# CLEANUP
# =========================================================

cap.release()
cv2.destroyAllWindows()

print("\n✅ Detector closed.")

